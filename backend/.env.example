APP_NAME="Corridor Watch API"
# true only on your own computer - never on a public server
APP_DEBUG=false
# Token needed to add/change/delete data through the API (header X-Admin-Token, "Authorize" in /docs).
# Leave empty = public server is read-only (changes allowed only from localhost).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ADMIN_TOKEN=
# List as JSON - frontend URLs allowed to call the API
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
