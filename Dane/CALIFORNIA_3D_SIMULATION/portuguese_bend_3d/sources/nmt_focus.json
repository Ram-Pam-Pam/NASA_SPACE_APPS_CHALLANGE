{
  "pipeline": [
    {
      "type": "readers.ept",
      "filename": "https://s3-us-west-2.amazonaws.com/usgs-lidar-public/USGS_LPC_CA_LosAngeles_2016_LAS_2018/ept.json",
      "bounds": "([-13184124, -13166824], [3989259, 4002659])",
      "resolution": 1.0,
      "threads": 8
    },
    {
      "type": "filters.range",
      "limits": "Classification[2:2]"
    },
    {
      "type": "filters.reprojection",
      "out_srs": "EPSG:32611"
    },
    {
      "type": "writers.gdal",
      "filename": "nmt_focus_5m.tif",
      "resolution": 5.0,
      "output_type": "mean",
      "window_size": 3,
      "data_type": "float32",
      "gdalopts": "COMPRESS=DEFLATE,TILED=YES"
    }
  ]
}
